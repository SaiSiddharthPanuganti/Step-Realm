# --- secrets ---------------------------------------------------------------
# .env holds a real generated JWT_SECRET. Never commit it.
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key

# Mappls credentials. The .a.conf / .i.conf files are bound to this app's
# package name and signing certificate, which makes them a credential: anyone
# holding them can serve map tiles as this app, and Mappls bills the account.
# The .olf files are the licence they unlock. Never commit any of them.
*.a.olf
*.i.olf
*.a.conf
*.i.conf
# The folder Mappls ships them in, named after the appId.
# Anchored with a leading slash on purpose. Written as `app*/` it matched every
# directory beginning with "app" at any depth -- including backend/app/ -- and
# .gitignore does not apply to already-tracked files, so the effect was
# invisible: existing modules kept committing normally while every *new* module
# under backend/app/ was silently dropped. Seven source files were in that trap.
# The credential files above are matched by extension anywhere in the tree, and
# /mobile/android/ already covers where the plugin copies them, so this rule is
# only a backstop for the vendor folder itself.
/app*/
# Where the config plugin reads them from. Credentials, same reasoning.
.mappls/
# The key, when it is pasted into a local file rather than app.json.
mappls-api-key*

# Google Maps SDK API key. Read by app.config.js at prebuild time and injected
# into the generated Android manifest; the file never touches app.json and so
# never touches Git.
google-maps-api-key*

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# --- alembic ---------------------------------------------------------------
# Migrations are source and must be committed; local artefacts are not.
alembic/versions/__pycache__/

# --- mobile (phases 10+) ---------------------------------------------------
node_modules/
.expo/
dist/
web-build/
*.orig.*
*.jks
*.keystore

# Native projects are generated by `npx expo prebuild` (Continuous Native
# Generation) and are never edited by hand. Ignoring them outright rather than
# listing build subdirectories is deliberate: the Mappls config plugin copies the
# .a.olf/.a.conf credentials into android/app/, so a partially-ignored native
# tree would eventually commit a licence file.
/mobile/android/
/mobile/ios/

# --- local dev artefacts ----------------------------------------------------
# Metro bundler runtime files. Written by `npm run dev` / the launcher scripts;
# they are process state and log output, not source.
metro.log
metro.log.err
metro.pid
# Agent session transcripts written to the repo root. Large and machine-local.
session-ses_*.md

# --- editors / os ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
