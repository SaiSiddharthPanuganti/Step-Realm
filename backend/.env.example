# Copy to .env and fill in. Never commit .env.
#
# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# docker-compose service (matches backend/docker-compose.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/steprealm
REDIS_URL=redis://localhost:6379/0

# Must be >= 32 chars. The placeholder below is rejected outside development.
JWT_SECRET=change-me-in-production-please-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Only used if WORLD_MAX_RADIUS_FROM_ORIGIN is set.
WORLD_ORIGIN_LAT=0.0
WORLD_ORIGIN_LON=0.0

# Arena boundary in hex rings from the origin above. Unset (the default) means an
# unbounded plane, which is the honest setting while the map is the real world.
# Setting it fences BOTH claiming and the map view: a claim beyond it is 422, and
# GET /world refuses a centre beyond it or clamps its radius to fit.
# WORLD_MAX_RADIUS_FROM_ORIGIN=25

# --- abuse guards -------------------------------------------------------------
# Fixed-window limits, per minute. Counted in PostgreSQL, one row per subject.
# Lower these behind a shared NAT before launch; a per-address login limit of 10
# is 10 for the whole office, not per person.
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
AUTH_SIGNUP_RATE_LIMIT_PER_MINUTE=5
CLAIM_LOCATION_RATE_LIMIT_PER_MINUTE=10

# Whether to read the client address from X-Forwarded-For. Turn ON only when the
# service is unreachable except through a proxy that overwrites the header --
# otherwise anyone can forge it and burn another player's allowance. Leave OFF
# for local development and any directly exposed deployment.
TRUST_FORWARDED_FOR=false

# Walking-speed ceiling used to reject step deltas that could not have been
# walked in the time since the player's previous sync. Raising it above a
# believable pace weakens the only step anti-cheat there is.
MAX_STEPS_PER_SECOND=5

# Railway injects DATABASE_URL / REDIS_URL automatically from the add-ons.
# Railway-specific: set JWT_SECRET as a service variable in the dashboard.
